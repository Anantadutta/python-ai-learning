# Copy this file to .env and fill in ONE of the options below.

# Option A - Groq (free tier, fast). Get a key at console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Option B - OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Option C - Ollama (fully local, no key; run `ollama pull llama3.1` first)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# Model names change over time - check your provider's current model list.
# Tune after running `python evaluate.py`:
# MIN_SIMILARITY=0.45
